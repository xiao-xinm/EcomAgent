# Shared MySQL connection used by stateful backend services.
SMARTCS_DB_URL=jdbc:mysql://mysql.internal:3306/smartcs_agent?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=true
SMARTCS_DB_USERNAME=smartcs_app
SMARTCS_DB_PASSWORD=<replace-with-database-secret>

# Browser origins. Keep this list explicit; wildcard origins are rejected.
SMARTCS_CORS_ALLOWED_ORIGINS=https://customer.example.com,https://workstation.example.com

# Internal service topology.
SMARTCS_AGENT_CORE_BASE_URL=http://smartcs-agent-core:8081
SMARTCS_SKILL_ENGINE_BASE_URL=http://smartcs-skill-engine:8082
SMARTCS_KNOWLEDGE_BASE_URL=http://smartcs-knowledge:8084
SMARTCS_NOTIFICATION_BASE_URL=http://smartcs-notification:8085

# Stateless production authentication.
SMARTCS_AUTH_STRICT_ENABLED=true
SMARTCS_AUTH_JWT_ENABLED=true
SMARTCS_AUTH_JWT_SECRET=<replace-with-at-least-32-random-characters>
SMARTCS_AUTH_JWT_ISSUER=https://identity.example.com
SMARTCS_AUTH_JWT_AUDIENCE=smartcs

# Knowledge retrieval. The hybrid profile requires pgvector, Elasticsearch and DashScope.
SMARTCS_RETRIEVAL_MODE=hybrid
SMARTCS_VECTOR_DB_URL=jdbc:postgresql://postgres.internal:5432/smartcs_knowledge
SMARTCS_VECTOR_DB_USERNAME=smartcs_knowledge
SMARTCS_VECTOR_DB_PASSWORD=<replace-with-vector-database-secret>
SMARTCS_ES_URL=https://elasticsearch.internal:9200
SMARTCS_ES_USERNAME=smartcs_knowledge
SMARTCS_ES_PASSWORD=<replace-with-elasticsearch-secret>
SMARTCS_ES_INDEX=smartcs_knowledge_faq_v1
DASHSCOPE_API_KEY=<replace-with-dashscope-api-key>
SMARTCS_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
SMARTCS_EMBEDDING_MODEL=text-embedding-v4
SMARTCS_EMBEDDING_DIMENSIONS=1024

# Keep synchronous user-message delivery for the first production rollout.
SMARTCS_NOTIFICATION_ENABLED=true
SMARTCS_NOTIFICATION_USER_MESSAGE_DIRECT_WRITE_ENABLED=true
SMARTCS_NOTIFICATION_OUTBOX_ENABLED=false
SMARTCS_NOTIFICATION_OUTBOX_FIXED_DELAY_MS=30000
SMARTCS_NOTIFICATION_OUTBOX_BATCH_SIZE=20
SMARTCS_NOTIFICATION_OUTBOX_MAX_ATTEMPTS=5
SMARTCS_NOTIFICATION_OUTBOX_LEASE_DURATION_MS=120000
SMARTCS_NOTIFICATION_OUTBOX_WORKER_ID=
SMARTCS_NOTIFICATION_RETRY_ENABLED=false
SMARTCS_NOTIFICATION_USER_SESSION_CHANNEL_ENABLED=false
SMARTCS_NOTIFICATION_RETRY_FIXED_DELAY_MS=30000
SMARTCS_NOTIFICATION_RETRY_BATCH_SIZE=20
SMARTCS_NOTIFICATION_RETRY_MAX_ATTEMPTS=5
SMARTCS_NOTIFICATION_RETRY_LEASE_DURATION_MS=120000
SMARTCS_NOTIFICATION_RETRY_WORKER_ID=
