# Gateway API base URL
VITE_API_BASE_URL=http://localhost:8080

# Customer user ID (for development only)
VITE_USER_ID=u1001
VITE_USER_ROLES=CUSTOMER

# Optional bearer token for future authenticated environments
VITE_AUTH_TOKEN=
VITE_AUTH_TOKEN_STORAGE_KEY=smartcs_auth_token
VITE_AUTH_REQUIRED=false
VITE_LOGIN_URL=
VITE_LOGIN_REDIRECT_ENABLED=true

# Chat channel
VITE_CHANNEL=h5

# Dev server port
VITE_PORT=3000

# Message polling interval in milliseconds
VITE_CHAT_POLLING_INTERVAL_MS=3000

# Optional SSE realtime channel. Keep false unless testing Phase 7 SSE spike.
VITE_CHAT_SSE_ENABLED=false
VITE_CHAT_SSE_AUTH_MODE=none
